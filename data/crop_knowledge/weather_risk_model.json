  "updated_at": "2026-10-26",
  "method": "deterministic agronomic suitability heuristic",
  "is_probability": false,
  "disclaimer": "Estimated weather-related risk for this crop at this location. It is a transparent agronomic heuristic built from crop tolerances and the local forecast, not a probability of crop loss, a disease diagnosis, or a substitute for field scouting and official advisories.",
  "score_scale": {
    "minimum": 0,
    "maximum": 100,
    "unit": "percent",
    "formula": "overall = round(0.65 * weighted_hazard_exposure + 0.35 * peak_hazard_exposure + compound_boost)",
    "bands": [
      { "level": "LOW", "tone": "low", "minimum": 0, "maximum": 29, "label": "Low estimated risk", "alert": false },
      { "level": "MODERATE", "tone": "moderate", "minimum": 30, "maximum": 59, "label": "Moderate estimated risk", "alert": true },
      { "level": "HIGH", "tone": "high", "minimum": 60, "maximum": 100, "label": "High estimated risk", "alert": true }
    ]
  },
  "weights": {
    "heat": 0.24,
    "cold": 0.17,
    "rain": 0.18,
    "dry": 0.14,
    "humidity": 0.17,
    "wind": 0.1
  },
  "hazard_labels": {
    "heat": "Heat stress",
    "cold": "Cold / frost stress",
    "rain": "Excess rain / waterlogging",
    "dry": "Dry spell / moisture deficit",
    "humidity": "Humidity-driven disease weather",
    "wind": "Wind / lodging"
  },
  "hazard_actions": {
    "heat": [
      "Irrigate in the early morning or evening and keep soil covered to reduce heat load.",
      "Delay fertiliser or spray operations to cooler hours and check for wilting or leaf scorch."
    ],
    "cold": [
      "Protect sensitive stages with light evening irrigation, mulch, or a crop cover where practical.",
      "Avoid late-evening irrigation before a cold night and check young plants for frost injury."
    ],
    "rain": [
      "Clear field drains and check low-lying patches before the next rain spell.",
      "Avoid unnecessary irrigation and inspect roots and stems for waterlogging stress after heavy rain."
    ],
    "dry": [
      "Check soil moisture below the surface before the next irrigation and prioritise the most sensitive stage.",
      "Mulch or conserve moisture where possible; avoid stressing flowering and fruit-setting plants."
    ],
    "humidity": [
      "Improve air movement around the canopy and avoid overhead irrigation while humidity stays high.",
      "Scout lower and inner leaves for early spots, blight, or mildew; confirm symptoms before any spray."
    ],
    "wind": [
      "Stake or support tall plants and check trellises, nets, and shade structures before gusty weather.",
      "Avoid spraying during windy hours and inspect stems for lodging or breakage after the wind event."
    ]
  },
